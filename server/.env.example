# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/secure-exam-paper-system

# JWT secret for authentication tokens
JWT_SECRET=your_jwt_secret_here

# (Optional) Hex-encoded 32-byte key for encrypting Shamir shares at rest
# If not set, a key is auto-generated at server/keys/share_master.key
# SHARE_ENCRYPTION_KEY=
